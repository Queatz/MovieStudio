# Movie Studio – environment template
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Load it into the server environment before running, e.g.:
#   set -a && source .env && set +a && ./gradlew :server:run

# ---------------------------------------------------------------------------
# Database – ArangoDB (document store for Movies, Assets, Tracks, Clips, Jobs, …)
# ---------------------------------------------------------------------------
# IMPORTANT: run ArangoDB with a PERSISTENT data directory, otherwise Movies and
# Assets are wiped on every restart. The bundled `docker-compose.yml` stores the
# data on a named volume for you: `docker compose up -d`.
# Never point ArangoDB's data directory at a tmpfs / temp path (e.g. /tmp).
ARANGO_HOST=127.0.0.1
ARANGO_PORT=8539
ARANGO_USER=root
ARANGO_PASSWORD=password
ARANGO_DB_NAME=moviestudio

# ---------------------------------------------------------------------------
# Alibaba Cloud account
# ---------------------------------------------------------------------------
ALIBABA_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Alibaba Cloud OSS (object storage) – RAM user credentials
# ---------------------------------------------------------------------------
OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------------------------------------------------------------------------
# Google Fonts Developer API – font catalog for text elements & captions
# ---------------------------------------------------------------------------
# Free API key: https://developers.google.com/fonts/docs/developer_api
# Without it the font picker only offers the app-bundled fonts. The catalog is
# cached server-side and refreshed at most every 7 days; picked fonts are
# downloaded once, re-hosted on OSS and reused across all movies.
GOOGLE_FONTS_API_KEY=

# ---------------------------------------------------------------------------
# Alibaba Model Studio (Qwen) – AI generation
# ---------------------------------------------------------------------------
QWEN_API_KEY=
QWEN_API_HOST=https://<workspace>.<region>.maas.aliyuncs.com
QWEN_OPENAI_BASE_URL=https://<workspace>.<region>.maas.aliyuncs.com/compatible-mode/v1
QWEN_DASHSCOPE_BASE_URL=https://<workspace>.<region>.maas.aliyuncs.com/api/v1
# Optional overrides (defaults shown):
QWEN_CHAT_MODEL=qwen-plus
QWEN_VIDEO_MODEL=wan3.0-video
QWEN_AUDIO_MODEL=thinksound-v1
QWEN_POLL_INTERVAL_MS=3000
QWEN_POLL_TIMEOUT_MS=3000000
